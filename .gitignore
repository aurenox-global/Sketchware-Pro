# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
.kotlin/

# Gradle files
.gradle/
build/
# Excepcion importante: estos son PAQUETES DE CODIGO FUENTE que se llaman "build".
# El patron "build/" de arriba los trataba como directorios de compilacion y los dejaba
# fuera del repo (por eso el CI no compilaba: faltaban BuildSettings, BuiltInLibraries, etc.).
!app/src/main/java/mod/hey/studios/build/
!app/src/main/java/mod/jbk/build/
!app/src/main/java/mod/pranav/build/

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

# Patch Files
*.patch
# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
*.jks
*.keystore

# Excepcion: la testkey es la clave PUBLICA de AOSP y es la que firma las releases de este fork
# (siempre la misma, para que las actualizaciones instalen encima). El CI la necesita para compilar.
!testkey.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md
.idea/render.experimental.xml
.DS_Store

# For users who uses android ide for building app
.androidide/
/actions-runner
release/